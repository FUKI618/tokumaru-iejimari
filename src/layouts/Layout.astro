---
interface Props {
  title: string;
  description: string;
}

import "../styles/global.css";

const { title, description } = Astro.props;
const canonicalUrl = Astro.url.href;
const siteUrl = Astro.url.origin;
const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="名古屋の家じまい相談窓口｜徳丸商会" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD: FAQPage (全8問) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "家じまいの費用の総額はどのくらいかかりますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "片付け・不用品処分で10万〜50万円、解体費用は木造30坪で90万〜150万円、鉄骨造で150万〜210万円が相場です。売却時は仲介手数料（売却価格×3%+6万円+税）や印紙代もかかります。"
          }
        },
        {
          "@type": "Question",
          "name": "家を解体せずにそのまま売却できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、「古家付き土地」として売却する方法があります。解体費用（90万〜250万円）を節約できるメリットがありますが、建物の状態によっては更地にした方が高く売れるケースもあります。"
          }
        },
        {
          "@type": "Question",
          "name": "更地にすると税金が上がるのですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "建物がある土地は住宅用地の特例で固定資産税が最大1/6に軽減されていますが、更地にするとこの特例が外れ税額が上がります。売却タイミングと合わせて計画的に進めることが重要です。"
          }
        },
        {
          "@type": "Question",
          "name": "遠方でも対応できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、対応しております。お立ち会いが難しい場合でも、現地の確認・鍵の受け渡し・作業の進捗報告まですべてお任せいただけます。"
          }
        },
        {
          "@type": "Question",
          "name": "相続登記の手続きも依頼できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "提携の司法書士をご紹介し、相続登記の手続きもサポートいたします。費用は5万〜15万円程度です。2024年4月から義務化され、3年以内に登記しない場合は10万円以下の過料が科される可能性があります。"
          }
        },
        {
          "@type": "Question",
          "name": "まだ親が住んでいるのですが相談できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "もちろんです。生前の家じまいは、ご本人の意思を確認しながら計画的に進められるため、おすすめしています。施設入居のタイミングに合わせた段階的な片付けも可能です。"
          }
        },
        {
          "@type": "Question",
          "name": "不用品の買取はしてもらえますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、古物商許可（第541042309800号）を取得しておりますので、家具・家電・骨董品・貴金属などを適正価格で買取いたします。買取額を処分費用と相殺することで、ご負担を軽減できます。"
          }
        },
        {
          "@type": "Question",
          "name": "費用を少しでも抑える方法はありますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ご自身で処分できる荷物は事前に片付ける、不用品の買取を活用する、解体・不動産は複数社から相見積もりを取るなどの方法があります。"
          }
        }
      ]
    })} />

    <!-- JSON-LD: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "名古屋の家じまい相談窓口｜徳丸商会",
      "description": "名古屋市・近郊エリアの家じまい・実家じまい。片付け・遺品整理・不用品買取から売却相談までワンストップ対応。",
      "telephone": "052-990-3968",
      "url": siteUrl,
      "image": ogImage,
      "priceRange": "$$",
      "openingHours": "Mo-Su 09:00-21:00",
      "areaServed": [
        {
          "@type": "City",
          "name": "名古屋市",
          "containedInPlace": { "@type": "State", "name": "愛知県" }
        },
        {
          "@type": "City",
          "name": "あま市"
        },
        {
          "@type": "City",
          "name": "清須市"
        },
        {
          "@type": "City",
          "name": "北名古屋市"
        },
        {
          "@type": "City",
          "name": "津島市"
        },
        {
          "@type": "City",
          "name": "愛西市"
        },
        {
          "@type": "City",
          "name": "弥富市"
        },
        {
          "@type": "City",
          "name": "東海市"
        },
        {
          "@type": "City",
          "name": "大府市"
        },
        {
          "@type": "City",
          "name": "刈谷市"
        },
        {
          "@type": "City",
          "name": "豊明市"
        },
        {
          "@type": "City",
          "name": "四日市市",
          "containedInPlace": { "@type": "State", "name": "三重県" }
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "家じまいサービス",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "遺品整理・片付け"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "不用品処分・買取"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "不動産売却相談"
            }
          }
        ]
      }
    })} />
  </head>
  <body class="antialiased">
    <slot />

    <!-- Alpine.js -->
    <script>
      import Alpine from "alpinejs";
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
