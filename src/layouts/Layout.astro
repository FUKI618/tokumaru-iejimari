---
interface Props {
  title: string;
  description: string;
}

import "../styles/global.css";

const { title, description } = Astro.props;
const canonicalUrl = Astro.url.href;
const siteUrl = Astro.url.origin;
const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- OGP -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="名古屋のゴミ屋敷清掃・片付け専門｜徳丸商会" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "徳丸商会トップ", "item": siteUrl }
      ]
    })} />

    <!-- JSON-LD: FAQPage (ゴミ屋敷清掃 全8問) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "ゴキブリやコバエがいて汚いですが対応できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、対応しております。害虫が発生している状態のゴミ屋敷も経験豊富なスタッフが対応します。害虫駆除もセットでご依頼いただくことで、清掃と同時に対処可能です。"
          }
        },
        {
          "@type": "Question",
          "name": "近所に知られずに作業できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "可能です。ロゴのない私服・作業着での対応、早朝や夜間作業のご相談にも応じます。プライバシーへの配慮を徹底しております。"
          }
        },
        {
          "@type": "Question",
          "name": "見積もり後に追加料金は発生しますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "一切発生しません。事前にお見積もりを提示し、ご了承いただいてから作業を開始します。隠れた費用は一切ございません。"
          }
        },
        {
          "@type": "Question",
          "name": "作業時間はどのくらいですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "間取りやゴミの量によって異なります。1R〜1Kで2〜4時間、1LDKで4〜6時間、2LDKで半日〜1日が目安です。詳細はお見積もり時にご説明します。"
          }
        },
        {
          "@type": "Question",
          "name": "不用品の買取もしてもらえますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、古物商許可（第541042309800号）を取得しており、家具・家電・骨董品・貴金属などを適正価格で買取いたします。買取額を清掃費用と相殺することでお得にご利用いただけます。"
          }
        },
        {
          "@type": "Question",
          "name": "スタッフの対応は丁寧ですか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "はい、経験豊富なスタッフが丁寧に対応いたします。お一人暮らしの方やご高齢の方も安心してご依頼ください。作業前に必ずご説明し、ご納得いただいてから作業を開始します。"
          }
        },
        {
          "@type": "Question",
          "name": "賃貸物件の原状回復にも対応できますか？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "対応しております。ゴミの撤去からハウスクリーニングまで、退去時の原状回復をトータルでサポートします。"
          }
        },
        {
          "@type": "Question",
          "name": "支払い方法は？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "現金のほか、各種クレジットカード・銀行振込に対応しております。作業完了後のお支払いですのでご安心ください。"
          }
        }
      ]
    })} />

    <!-- JSON-LD: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "@id": siteUrl + "#localbusiness",
      "name": "名古屋のゴミ屋敷清掃・片付け専門｜徳丸商会",
      "description": "名古屋市・近郊エリアのゴミ屋敷清掃・汚部屋片付けなら徳丸商会。24時間対応・追加料金なし・害虫駆除・ハウスクリーニングまで一括対応。",
      "telephone": "052-990-3968",
      "url": siteUrl,
      "image": ogImage,
      "priceRange": "$$",
      "openingHours": "Mo-Su 00:00-23:59",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "名古屋市",
        "addressRegion": "愛知県",
        "addressCountry": "JP",
        "streetAddress": "",
        "postalCode": ""
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "35.1709",
        "longitude": "136.8815"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "387",
        "bestRating": "5"
      },
      "areaServed": [
        { "@type": "City", "name": "名古屋市", "containedInPlace": { "@type": "State", "name": "愛知県" } },
        { "@type": "City", "name": "あま市" },
        { "@type": "City", "name": "清須市" },
        { "@type": "City", "name": "北名古屋市" },
        { "@type": "City", "name": "津島市" },
        { "@type": "City", "name": "愛西市" },
        { "@type": "City", "name": "弥富市" },
        { "@type": "City", "name": "東海市" },
        { "@type": "City", "name": "大府市" },
        { "@type": "City", "name": "刈谷市" },
        { "@type": "City", "name": "豊明市" },
        { "@type": "City", "name": "四日市市", "containedInPlace": { "@type": "State", "name": "三重県" } }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "ゴミ屋敷清掃サービス",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ゴミ屋敷片付け・清掃" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ハウスクリーニング" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "害虫駆除" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "不用品搬出・買取" } }
        ]
      }
    })} />

    <!-- JSON-LD: HowTo -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "名古屋でゴミ屋敷清掃を依頼する方法",
      "description": "徳丸商会のゴミ屋敷清掃サービスを利用する手順です。",
      "totalTime": "PT4H",
      "estimatedCost": {
        "@type": "MonetaryAmount",
        "currency": "JPY",
        "value": "14900"
      },
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "お電話・LINEでお問い合わせ", "text": "清掃希望のお部屋の状況や訪問日時をお伝えください。052-990-3968まで。24時間受付中。" },
        { "@type": "HowToStep", "position": 2, "name": "無料お見積もり", "text": "スタッフが現地を訪問し、ゴミの量や状態を確認して正確なお見積もりをご提示します。" },
        { "@type": "HowToStep", "position": 3, "name": "作業開始・完了", "text": "ご納得いただいた後に作業開始。ゴミ撤去・清掃・害虫駆除まで一括対応します。" },
        { "@type": "HowToStep", "position": 4, "name": "お支払い", "text": "作業完了を確認後、現金・クレジットカード・銀行振込でお支払い。追加料金は一切ありません。" }
      ]
    })} />
  </head>
  <body class="antialiased">
    <slot />

    <!-- Alpine.js -->
    <script>
      import Alpine from "alpinejs";
      window.Alpine = Alpine;
      Alpine.start();
    </script>
  </body>
</html>
