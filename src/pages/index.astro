---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const asset = (p: string) => `${base}${p.replace(/^\/+/, "")}`;

const logo      = asset("logo.svg");
const hero      = asset("images/gomi/hero.webp");
const before1   = asset("images/gomi/before1.webp");
const after1    = asset("images/gomi/after1.webp");
const svcClean  = asset("images/gomi/service-cleanup.webp");
const svcCleaning = asset("images/gomi/service-cleaning.webp");
const svcPest   = asset("images/gomi/service-pest.webp");
const svcHaul   = asset("images/gomi/service-hauling.webp");
const bgWorry   = asset("images/gomi/bg-worry.webp");
const staffF    = asset("images/gomi/staff-female.webp");
const bgArea    = asset("images/gomi/bg-area.webp");
const bgConsult = asset("images/gomi/bg-consultation.webp");
const before2   = asset("images/gomi/before2.webp");
const after2    = asset("images/gomi/after2.webp");
const before3   = asset("images/gomi/before3.webp");
const after3    = asset("images/gomi/after3.webp");
const before4   = asset("images/gomi/before4.webp");
const after4    = asset("images/gomi/after4.webp");
const buyoutCabinet = asset("images/gomi/buyout-cabinet.webp");
const buyoutWasher  = asset("images/gomi/buyout-washer.webp");
const buyoutTires   = asset("images/gomi/buyout-tires.webp");
const buyoutTable   = asset("images/gomi/buyout-table.webp");
const svcPrivacy    = asset("images/gomi/service-privacy.webp");
const bgHappy       = asset("images/gomi/bg-happy.webp");
---

<Layout
  title="名古屋のゴミ屋敷清掃・片付けなら徳丸商会｜24時間対応"
  description="名古屋市・近郊のゴミ屋敷清掃・汚部屋片付けなら徳丸商会。24時間対応・追加料金なし・女性スタッフ在籍。害虫駆除・ハウスクリーニングまで一括対応。052-990-3968"
>

<!-- ===========================
     1. HEADER (fixed)
     =========================== -->
<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-border" style="height:60px;">
  <div class="max-w-6xl mx-auto px-3 h-full flex items-center justify-between gap-2">
    <!-- Logo + Name -->
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label="徳丸商会 トップページへ">
      <img src={logo} alt="徳丸商会ロゴ" width="40" height="40" class="w-10 h-10 object-contain" loading="eager" />
      <span class="hidden sm:block text-sm font-bold text-teal-dark leading-tight">徳丸商会<br /><span class="text-[10px] font-normal text-text-light">ゴミ屋敷清掃</span></span>
    </a>

    <!-- PC Nav -->
    <nav class="hidden md:flex items-center gap-5 text-sm text-text-light">
      <a href="#services" class="hover:text-teal transition-colors">サービス</a>
      <a href="#price" class="hover:text-teal transition-colors">料金</a>
      <a href="#flow" class="hover:text-teal transition-colors">流れ</a>
      <a href="#faq" class="hover:text-teal transition-colors">FAQ</a>
    </nav>

    <!-- CTA Buttons -->
    <div class="flex items-center gap-1.5 shrink-0">
      <a href="tel:052-990-3968"
         class="flex items-center gap-1 bg-teal text-white rounded-md px-2.5 py-1.5 text-[11px] font-bold leading-none hover:bg-teal-dark transition-colors">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
        <span class="whitespace-nowrap">無料電話</span>
      </a>
      <a href="https://lin.ee/j4wK9IM" target="_blank" rel="noopener noreferrer"
         class="flex items-center gap-1 bg-line text-white rounded-md px-2.5 py-1.5 text-[11px] font-bold leading-none hover:opacity-90 transition-opacity">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
        <span class="whitespace-nowrap">LINE相談</span>
      </a>
    </div>
  </div>
</header>

<!-- PC Header height spacer -->
<div class="h-[60px]"></div>


<!-- ===========================
     2. HERO
     =========================== -->
<section id="hero" class="bg-teal-dark">
  <!-- Mobile: image top, text bottom -->
  <div class="md:hidden">
    <div class="w-full aspect-video overflow-hidden">
      <img src={hero} alt="名古屋のゴミ屋敷清掃・片付けを担当する徳丸商会スタッフチーム"
           width="800" height="450"
           class="w-full h-full object-cover object-center"
           loading="eager" fetchpriority="high" />
    </div>
    <div class="px-4 py-6 text-white">
      <p class="text-[11px] font-bold text-orange-light mb-2 uppercase tracking-wider">名古屋No.1 ゴミ屋敷清掃</p>
      <h1 class="text-xl font-bold leading-snug mb-3">
        名古屋のゴミ屋敷清掃・<br />片付けなら<span class="text-orange-light">徳丸商会</span>
      </h1>
      <p class="text-sm text-white/80 mb-4 leading-relaxed">
        散らかった部屋も最短即日対応。<br />女性スタッフ在籍・追加料金一切なし。
      </p>
      <!-- Badges -->
      <div class="flex flex-wrap gap-1.5 mb-5">
        {["24時間対応", "追加料金なし", "女性スタッフ在籍", "秘密厳守"].map(b => (
          <span class="bg-white/20 text-white text-[11px] px-2 py-0.5 rounded-full border border-white/30 whitespace-nowrap">{b}</span>
        ))}
      </div>
      <!-- CTA -->
      <div class="flex gap-2">
        <a href="tel:052-990-3968"
           class="flex-1 flex items-center justify-center gap-1.5 bg-orange text-white font-bold rounded-lg py-3 text-sm cta-glow">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
          <span class="whitespace-nowrap">無料電話相談</span>
        </a>
        <a href="https://lin.ee/j4wK9IM" target="_blank" rel="noopener noreferrer"
           class="flex-1 flex items-center justify-center gap-1.5 bg-line text-white font-bold rounded-lg py-3 text-sm cta-glow-line">
          <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.630 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.630 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          <span class="whitespace-nowrap">LINEで相談</span>
        </a>
      </div>
    </div>
  </div>

  <!-- PC: bg image + right text overlay -->
  <div class="hidden md:block relative min-h-[520px]">
    <img src={hero} alt="名古屋のゴミ屋敷清掃・片付けを担当する徳丸商会スタッフチーム"
         width="1200" height="675"
         class="absolute inset-0 w-full h-full object-cover object-center"
         loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-teal-dark/70 via-teal-dark/40 to-transparent"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-6 py-16 flex items-center min-h-[520px]">
      <div class="max-w-xl text-white">
        <p class="text-sm font-bold text-orange-light mb-3 uppercase tracking-widest">名古屋No.1 ゴミ屋敷清掃</p>
        <h1 class="text-4xl font-bold leading-tight mb-4">
          名古屋のゴミ屋敷清掃・<br />片付けなら<span class="text-orange-light">徳丸商会</span>
        </h1>
        <p class="text-base text-white/85 mb-6 leading-relaxed">
          散らかった部屋も最短即日対応。<br />女性スタッフ在籍・追加料金一切なし。
        </p>
        <div class="flex flex-wrap gap-2 mb-7">
          {["24時間対応", "追加料金なし", "女性スタッフ在籍", "秘密厳守"].map(b => (
            <span class="bg-white/20 text-white text-sm px-3 py-1 rounded-full border border-white/30 whitespace-nowrap">{b}</span>
          ))}
        </div>
        <div class="flex gap-3">
          <a href="tel:052-990-3968"
             class="flex items-center gap-2 bg-orange hover:bg-orange-dark text-white font-bold rounded-xl px-6 py-4 text-base transition-colors cta-glow">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
            今すぐ無料電話
          </a>
          <a href="https://lin.ee/j4wK9IM" target="_blank" rel="noopener noreferrer"
             class="flex items-center gap-2 bg-line hover:opacity-90 text-white font-bold rounded-xl px-6 py-4 text-base transition-opacity cta-glow-line">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.630 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.630 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
            LINEで無料相談
          </a>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ===========================
     3. 信頼バー
     =========================== -->
<section class="bg-bg-white border-t-4 border-teal py-6 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="grid grid-cols-3 gap-3 stagger-children">
      {[
        { num: "3,000", unit: "件+", label: "累計実績" },
        { num: "98", unit: "%", label: "お客様満足度" },
        { num: "0", unit: "円", label: "見積もり費用" },
      ].map(item => (
        <div class="reveal text-center">
          <div class="text-2xl md:text-4xl font-bold text-teal leading-none">
            <span class="count-up">{item.num}</span><span class="text-lg md:text-2xl text-orange">{item.unit}</span>
          </div>
          <p class="text-[11px] md:text-sm text-text-light mt-1">{item.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ===========================
     4. お悩みセクション
     =========================== -->
<section class="relative py-12 md:py-20 px-4 overflow-hidden">
  <img src={bgWorry} alt="ゴミ屋敷片付けに悩む女性"
       width="1200" height="675"
       class="absolute inset-0 w-full h-full object-cover object-top"
       loading="lazy" />
  <div class="absolute inset-0 bg-teal-dark/80"></div>
  <div class="relative z-10 max-w-4xl mx-auto">
    <h2 class="text-lg md:text-3xl font-bold text-white text-center mb-8 reveal">
      こんなお悩みありませんか？
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 stagger-children">
      {[
        "部屋がゴミで埋まって手がつけられない",
        "近所に知られたくない",
        "害虫が発生している",
        "女性一人で業者を呼ぶのが不安",
        "追加料金が怖い",
        "どこに頼めばいいかわからない",
      ].map(worry => (
        <div class="reveal flex items-start gap-3 bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-4">
          <span class="text-orange-light text-xl shrink-0 mt-0.5" aria-hidden="true">✓</span>
          <p class="text-white text-sm md:text-base leading-relaxed">{worry}</p>
        </div>
      ))}
    </div>
    <p class="text-center text-white text-sm md:text-base mt-8 font-bold reveal">
      そのお悩み、徳丸商会が全て解決します。
    </p>
  </div>
</section>


<!-- ===========================
     4.5 業者選びトラブル警告
     =========================== -->
<section class="py-12 md:py-16 px-4 bg-white">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8 reveal">
      <p class="text-xs font-bold text-red-600 uppercase tracking-widest mb-1">WARNING</p>
      <h2 class="text-lg md:text-2xl font-bold text-text">正しい片付け業者を選ばないとこんなトラブルも…</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 stagger-children">
      {[
        {
          label: "大事なものも捨てられた…",
          iconPath: "M3 6h18 M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2",
        },
        {
          label: "見積りと違う高額請求",
          iconPath: "M12 1v22 M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",
        },
        {
          label: "追加料金で倍額に",
          iconPath: "M12 19V5 M5 12l7-7 7 7",
        },
        {
          label: "ご近所からクレーム",
          iconPath: "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10",
        },
      ].map(item => (
        <div class="reveal flex flex-col items-center gap-3 bg-red-50 border border-red-200 rounded-2xl p-4 text-center">
          <div class="w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={item.iconPath}/>
            </svg>
          </div>
          <p class="text-xs md:text-sm font-bold text-red-700 leading-snug">{item.label}</p>
        </div>
      ))}
    </div>
    <p class="text-center text-sm md:text-base font-bold text-teal mt-8 reveal">
      徳丸商会なら、これらのトラブルは一切ありません。
    </p>
  </div>
</section>


<!-- ===========================
     5. 対応サービス
     =========================== -->
<section id="services" class="py-12 md:py-20 px-4 bg-bg">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-8 reveal">
      <p class="text-xs font-bold text-teal uppercase tracking-widest mb-1">SERVICES</p>
      <h2 class="text-xl md:text-3xl font-bold text-text">ゴミ屋敷清掃の対応サービス</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 stagger-children">
      {[
        { img: svcClean,    alt: "ゴミ屋敷片付け・不用品撤去サービス",      title: "ゴミ屋敷\n片付け",      desc: "部屋中のゴミを仕分け・撤去。どんな状態でも対応。" },
        { img: svcCleaning, alt: "ハウスクリーニング・汚部屋清掃サービス",   title: "ハウス\nクリーニング", desc: "清掃後の室内を隅々まで清潔に。原状回復にも対応。" },
        { img: svcPest,     alt: "ゴキブリ・ハエ害虫駆除サービス",          title: "害虫駆除",              desc: "ゴキブリ・コバエ等の害虫を専門薬剤で完全駆除。" },
        { img: svcHaul,     alt: "不用品搬出・トラック積込みサービス",       title: "不用品搬出",            desc: "大型家具・家電も丁寧に搬出。買取で費用節約も。" },
      ].map(svc => (
        <div class="reveal bg-bg-white rounded-2xl overflow-hidden shadow-sm card-hover">
          <div class="aspect-[4/3] overflow-hidden">
            <img src={svc.img} alt={svc.alt}
                 width="400" height="300"
                 class="w-full h-full object-cover"
                 loading="lazy" />
          </div>
          <div class="p-3 md:p-4">
            <h3 class="text-sm md:text-base font-bold text-text mb-1 whitespace-pre-line leading-snug">{svc.title}</h3>
            <p class="text-[11px] md:text-xs text-text-light leading-relaxed">{svc.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ===========================
     6. 3つの安心ポイント
     =========================== -->
<section class="py-12 md:py-20 px-4 bg-teal-bg">
  <div class="max-w-5xl mx-auto">
