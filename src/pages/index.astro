---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Definition from "../components/Definition.astro";
import Timing from "../components/Timing.astro";
import Process from "../components/Process.astro";
import Costs from "../components/Costs.astro";
import Service from "../components/Service.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import FloatingCTA from "../components/FloatingCTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="名古屋の家じまい・実家じまい相談窓口｜徳丸商会｜片付け・遺品整理・不用品買取"
  description="名古屋市・近郊エリアの家じまい・実家じまいなら徳丸商会。片付け・遺品整理・不用品買取から売却相談まで、ワンストップでサポート。出張費無料・その場で現金払い。まずは無料相談を。"
>
  <Header />
  <main>
    <Hero />
    <Problem />
    <Definition />
    <Timing />
    <Process />
    <Costs />
    <Service />
    <FAQ />
    <CTASection />
  </main>
  <Footer />
  <FloatingCTA />
</Layout>
