---
const phone = "052-990-3968";
const phoneHref = "tel:0529903968";

const prefectures = [
  "北海道","青森県","岩手県","宮城県","秋田県","山形県","福島県",
  "茨城県","栃木県","群馬県","埼玉県","千葉県","東京都","神奈川県",
  "新潟県","富山県","石川県","福井県","山梨県","長野県","岐阜県",
  "静岡県","愛知県","三重県","滋賀県","京都府","大阪府","兵庫県",
  "奈良県","和歌山県","鳥取県","島根県","岡山県","広島県","山口県",
  "徳島県","香川県","愛媛県","高知県","福岡県","佐賀県","長崎県",
  "熊本県","大分県","宮崎県","鹿児島県","沖縄県",
];
---

<section id="contact" class="py-16 sm:py-20 bg-navy text-white">
  <div class="mx-auto max-w-[1200px] px-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-4">
      まずは無料相談から
    </h2>
    <p class="text-center text-white/70 mb-12 max-w-2xl mx-auto">
      家じまいのプロが、あなたの状況に合わせた最適なプランをご提案します。<br />
      お気軽にご相談ください。
    </p>

    <div class="grid md:grid-cols-2 gap-10 max-w-4xl mx-auto">
      <!-- Phone CTA -->
      <div class="bg-white/10 backdrop-blur rounded-2xl p-8 text-center flex flex-col justify-center">
        <p class="text-gold font-bold text-lg mb-4">お電話でのご相談</p>
        <a
          href={phoneHref}
          class="text-3xl sm:text-4xl font-bold text-white hover:text-gold transition-colors mb-3 flex items-center justify-center gap-3"
        >
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
          {phone}
        </a>
        <p class="text-white/60 text-sm">受付時間：9:00〜21:00（年中無休）</p>
        <p class="text-white/40 text-xs mt-2">タップで電話がかけられます</p>
      </div>

      <!-- Form -->
      <div class="bg-white rounded-2xl p-8">
        <p class="text-navy font-bold text-lg mb-6 text-center">フォームでのご相談</p>
        <form action="https://formspree.io/f/placeholder" method="POST" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-bold text-navy mb-1">お名前 <span class="text-red-500">*</span></label>
            <input
              type="text"
              id="name"
              name="name"
              required
              placeholder="山田 太郎"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy text-base focus:ring-2 focus:ring-gold focus:border-gold outline-none"
            />
          </div>

          <div>
            <label for="tel" class="block text-sm font-bold text-navy mb-1">電話番号 <span class="text-red-500">*</span></label>
            <input
              type="tel"
              id="tel"
              name="phone"
              required
              placeholder="090-1234-5678"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy text-base focus:ring-2 focus:ring-gold focus:border-gold outline-none"
            />
          </div>

          <div>
            <label for="prefecture" class="block text-sm font-bold text-navy mb-1">物件の所在地</label>
            <select
              id="prefecture"
              name="prefecture"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy text-base focus:ring-2 focus:ring-gold focus:border-gold outline-none"
            >
              <option value="">都道府県を選択</option>
              {prefectures.map((p) => (
                <option value={p}>{p}</option>
              ))}
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-bold text-navy mb-1">ご相談内容</label>
            <textarea
              id="message"
              name="message"
              rows="3"
              placeholder="例：実家の片付けについて相談したい"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg text-navy text-base focus:ring-2 focus:ring-gold focus:border-gold outline-none resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-4 bg-gold hover:bg-gold-light text-white font-bold rounded-lg transition-colors text-lg min-h-[56px]"
          >
            無料相談を申し込む
          </button>

          <p class="text-xs text-warm-gray-light text-center">
            <a href="/privacy-policy" target="_blank" class="underline hover:text-navy transition-colors">プライバシーポリシー</a>に同意の上、送信してください。
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
