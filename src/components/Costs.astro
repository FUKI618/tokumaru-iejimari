---
const mainCosts = [
  {
    category: "不用品処分・片付け",
    range: "10万〜50万円",
    note: "間取り・荷物量により変動。1Kで5万円前後、一軒家で30〜50万円が目安",
  },
  {
    category: "解体費用（木造・30坪）",
    range: "90万〜150万円",
    note: "木造が最も安価。坪単価3〜5万円が相場",
  },
  {
    category: "解体費用（木造・50坪）",
    range: "150万〜250万円",
    note: "広い家屋はアスベスト調査費用が別途かかる場合あり",
  },
  {
    category: "解体費用（鉄骨造・30坪）",
    range: "150万〜210万円",
    note: "木造より割高。坪単価5〜7万円が相場",
  },
  {
    category: "解体費用（RC造・30坪）",
    range: "180万〜240万円",
    note: "鉄筋コンクリートは最も高額。坪単価6〜8万円",
  },
];

const otherCosts = [
  {
    category: "測量費用",
    range: "10万〜30万円",
    note: "境界確定が必要な場合。隣地トラブル防止に重要",
  },
  {
    category: "仲介手数料",
    range: "売却価格×3%+6万円+税",
    note: "例：1,000万円の売却で約40万円",
  },
  {
    category: "印紙代",
    range: "1,000円〜6万円",
    note: "売買契約書に貼付。売却価格により変動",
  },
  {
    category: "相続登記",
    range: "5万〜15万円",
    note: "司法書士への依頼費用。2024年4月より義務化",
  },
];
---

<section class="py-16 sm:py-20 bg-white">
  <div class="mx-auto max-w-[1200px] px-4">
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-navy mb-4">
      費用の目安とリスク
    </h2>
    <p class="text-center text-warm-gray mb-12 max-w-2xl mx-auto">
      家じまいにかかる費用は、建物の構造や広さで大きく変わります。<br />
      まずは無料見積もりで正確な金額をご確認ください。
    </p>

    <!-- Main cost table -->
    <div class="max-w-4xl mx-auto mb-8">
      <h3 class="text-lg font-bold text-navy mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        片付け・解体にかかる費用
      </h3>
      <div class="bg-cream rounded-2xl overflow-hidden">
        <div class="grid grid-cols-[1fr_auto_1fr] gap-2 bg-navy text-white p-4 font-bold text-sm sm:text-base">
          <span>項目</span>
          <span>費用目安</span>
          <span>備考</span>
        </div>
        {mainCosts.map((item, i) => (
          <div class={`grid grid-cols-[1fr_auto_1fr] gap-2 p-4 text-sm sm:text-base ${i % 2 === 0 ? 'bg-cream' : 'bg-white'}`}>
            <span class="font-bold text-navy">{item.category}</span>
            <span class="text-gold font-bold whitespace-nowrap">{item.range}</span>
            <span class="text-warm-gray text-sm">{item.note}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Other costs table -->
    <div class="max-w-4xl mx-auto mb-12">
      <h3 class="text-lg font-bold text-navy mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        売却・手続きにかかる費用
      </h3>
      <div class="bg-cream rounded-2xl overflow-hidden">
        <div class="grid grid-cols-[1fr_auto_1fr] gap-2 bg-navy text-white p-4 font-bold text-sm sm:text-base">
          <span>項目</span>
          <span>費用目安</span>
          <span>備考</span>
        </div>
        {otherCosts.map((item, i) => (
          <div class={`grid grid-cols-[1fr_auto_1fr] gap-2 p-4 text-sm sm:text-base ${i % 2 === 0 ? 'bg-cream' : 'bg-white'}`}>
            <span class="font-bold text-navy">{item.category}</span>
            <span class="text-gold font-bold whitespace-nowrap">{item.range}</span>
            <span class="text-warm-gray text-sm">{item.note}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Cost saving tips -->
    <div class="max-w-4xl mx-auto mb-12 bg-blue-50 rounded-2xl p-8 border border-blue-200">
      <h3 class="text-xl font-bold text-navy mb-4 flex items-center gap-2">
        <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
        費用を抑えるポイント
      </h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
          <div>
            <p class="font-bold text-navy text-sm">複数社から見積もりを取る</p>
            <p class="text-warm-gray text-sm">解体業者・不動産会社は最低3社から相見積もりを</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
          <div>
            <p class="font-bold text-navy text-sm">不用品は買取を活用</p>
            <p class="text-warm-gray text-sm">家具・家電・骨董品などは買取で処分費を軽減</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
          <div>
            <p class="font-bold text-navy text-sm">自分で片付けられる範囲は自力で</p>
            <p class="text-warm-gray text-sm">業者に依頼する荷物量を減らすだけで数万円の差に</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-gold shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
          <div>
            <p class="font-bold text-navy text-sm">更地化前に税金の確認を</p>
            <p class="text-warm-gray text-sm">更地にすると住宅用地特例が外れ固定資産税が上がる場合あり</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Risk warning -->
    <div class="max-w-4xl mx-auto bg-red-50 rounded-2xl p-8 border border-red-200">
      <h3 class="text-xl font-bold text-red-700 mb-4 flex items-center gap-2">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
        </svg>
        放置するとこうなります
      </h3>

      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="text-red-500 font-bold shrink-0">1</span>
          <div>
            <p class="font-bold text-red-700">「特定空き家」に指定される</p>
            <p class="text-red-600 text-sm">空き家対策特別措置法により、倒壊の危険・衛生上有害・景観を損なう等の場合に自治体が指定</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-500 font-bold shrink-0">2</span>
          <div>
            <p class="font-bold text-red-700">固定資産税が最大6倍に</p>
            <p class="text-red-600 text-sm">住宅用地の特例措置（最大1/6に軽減）が解除。例：年5万円→年30万円になるケースも</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-500 font-bold shrink-0">3</span>
          <div>
            <p class="font-bold text-red-700">行政代執行で強制解体</p>
            <p class="text-red-600 text-sm">所有者負担で強制解体。通常の解体より割高になり、費用が数百万円に膨らむことも</p>
          </div>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-red-500 font-bold shrink-0">4</span>
          <div>
            <p class="font-bold text-red-700">相続登記の義務違反で過料</p>
            <p class="text-red-600 text-sm">2024年4月施行。正当な理由なく3年以内に登記しない場合、10万円以下の過料が科される可能性</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center mt-10">
      <a
        href="#contact"
        class="inline-flex items-center px-8 py-4 bg-gold hover:bg-gold-light text-white font-bold rounded-lg transition-colors min-h-[48px]"
      >
        まずは無料見積もりから
      </a>
    </div>
  </div>
</section>
